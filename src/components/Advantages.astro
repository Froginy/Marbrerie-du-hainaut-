---

<section id="advantages" class="relative py-24 sm:py-32 bg-light overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block">Pourquoi nous choisir</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text">
        Les avantages de <span class="text-accent">nos services</span>
      </h2>
    </div>

    <!-- Advantages grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {advantages.map((adv, index) => (
        <div class="reveal group" style={`transition-delay: ${index * 0.1}s`}>
          <div class="h-full bg-light-surface border border-border-light rounded-xl p-7 transition-all duration-500 hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-1">
            <!-- Icon -->
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center text-accent mb-5 transition-all duration-300 group-hover:bg-accent group-hover:text-white" set:html={adv.icon} />

            <h3 class="font-heading text-lg font-semibold text-dark-text mb-3 group-hover:text-accent transition-colors duration-300">{adv.title}</h3>
            <p class="text-dark-text-muted text-sm leading-relaxed">{adv.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
