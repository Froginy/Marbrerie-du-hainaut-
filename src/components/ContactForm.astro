---
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pt-16">
  <!-- Contact Info Column -->
  <div class="lg:col-span-5 reveal">
    <h2 class="font-heading text-3xl font-semibold text-dark-text mb-6">Discutons de votre projet</h2>
    <p class="text-dark-text-muted leading-relaxed mb-10">
      Que ce soit pour une demande de devis, un renseignement sur nos réalisations ou un conseil personnalisé, notre équipe d'artisans marbriers est à votre disposition pour vous accompagner dans toutes vos démarches.
    </p>

    <div class="space-y-8">
      <!-- Address -->
      <div class="flex gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-dark-text mb-1">Notre atelier</h3>
          <p class="text-dark-text-muted text-sm leading-relaxed">
            Parc d'activités du Saubois<br />
            1M rue du Savoir Faire<br />
            59230 Saint-Amand-les-Eaux
          </p>
        </div>
      </div>

      <!-- Phone -->
      <div class="flex gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-dark-text mb-1">Téléphone</h3>
          <a href="tel:0362020950" class="text-accent text-sm font-semibold hover:text-accent-light transition-colors duration-300">
            03 62 02 09 50
          </a>
          <p class="text-dark-text-muted text-xs mt-1">Lundi au Vendredi, de 8h à 18h</p>
        </div>
      </div>

      <!-- Email -->
      <div class="flex gap-4">
        <div class="flex-shrink-0 w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center text-accent">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-lg font-semibold text-dark-text mb-1">Email</h3>
          <a href="mailto:contact@marbrerieduhainaut.fr" class="text-accent text-sm font-semibold hover:text-accent-light transition-colors duration-300">
            contact@marbrerieduhainaut.fr
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Form Column -->
  <div class="lg:col-span-7 reveal" style="transition-delay: 0.2s">
    <div class="bg-light border border-border-light rounded-xl p-6 sm:p-10 shadow-xl shadow-accent/5">
      <form action="#" method="POST" class="space-y-6">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Prénom -->
          <div>
            <label for="prenom" class="block text-sm font-medium text-dark-text mb-2">Prénom *</label>
            <input 
              type="text" 
              id="prenom" 
              name="prenom" 
              required 
              class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300"
              placeholder="Jean"
            />
          </div>
          
          <!-- Nom -->
          <div>
            <label for="nom" class="block text-sm font-medium text-dark-text mb-2">Nom *</label>
            <input 
              type="text" 
              id="nom" 
              name="nom" 
              required 
              class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300"
              placeholder="Dupont"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <!-- Téléphone -->
          <div>
            <label for="telephone" class="block text-sm font-medium text-dark-text mb-2">Téléphone</label>
            <input 
              type="tel" 
              id="telephone" 
              name="telephone" 
              class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300"
              placeholder="06 12 34 56 78"
            />
          </div>
          
          <!-- E-mail -->
          <div>
            <label for="email" class="block text-sm font-medium text-dark-text mb-2">E-mail *</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300"
              placeholder="jean.dupont@exemple.fr"
            />
          </div>
        </div>

        <!-- Sujet -->
        <div>
          <label for="sujet" class="block text-sm font-medium text-dark-text mb-2">Sujet de votre demande *</label>
          <select 
            id="sujet" 
            name="sujet" 
            required 
            class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300 appearance-none"
          >
            <option value="" disabled selected>Sélectionnez un sujet...</option>
            <option value="devis_monument">Demande de devis pour un monument</option>
            <option value="devis_cavurne">Demande de devis pour une cavurne</option>
            <option value="reparation">Demande de réparation / rénovation</option>
            <option value="rdv">Prise de rendez-vous</option>
            <option value="autre">Autre demande</option>
          </select>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-sm font-medium text-dark-text mb-2">Votre message *</label>
          <textarea 
            id="message" 
            name="message" 
            rows="5" 
            required 
            class="w-full bg-light-surface border border-border-light rounded-md px-4 py-3 text-dark-text text-sm focus:outline-none focus:ring-2 focus:ring-accent/50 focus:border-accent transition-all duration-300 resize-none"
            placeholder="Détaillez votre projet ou votre demande ici..."
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button 
            type="submit" 
            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 rounded-sm bg-accent px-8 py-3.5 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light hover:shadow-xl hover:shadow-accent/25 hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
            Envoyer le message
          </button>
          <p class="text-dark-text-muted text-xs mt-4">
            * Champs obligatoires. Vos données resteront confidentielles et ne seront pas partagées.
          </p>
        </div>

      </form>
    </div>
  </div>
</div>
