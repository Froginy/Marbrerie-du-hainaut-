---
import { Image } from "astro:assets";
import imgMonu1 from "../assets/monuments/monument-blanc.jpg";
import imgMonu2 from "../assets/monuments/monument-noir-1.jpg";
import imgMonu3 from "../assets/monuments/monument-noir-2.jpg";
import imgMonu4 from "../assets/monuments/monument-noir-rose.jpg";
import imgMonu5 from "../assets/monuments/monument-bicolore-rouge-noir.jpg";
import imgMonu6 from "../assets/monuments/monument-granit-rouge.jpg";
import imgMonu7 from "../assets/monuments/monument-noir-liseret-rouge.jpg";

const galleryItems = [
  { id: 1, title: "Monument en pierre blanche", category: "classique", description: "Sépulture classique aux lignes épurées et lumineuses.", image: imgMonu1 },
  { id: 2, title: "Monument en granit noir", category: "classique", description: "Design intemporel et élégant en granit noir massif.", image: imgMonu2 },
  { id: 3, title: "Monument noir contemporain", category: "contemporain", description: "Lignes modernes avec un superbe contraste de lumière.", image: imgMonu3 },
  { id: 4, title: "Monument noir avec ornement", category: "personnalise", description: "Stèle noire agrémentée d'une magnifique rose sculptée.", image: imgMonu4 },
  { id: 5, title: "Monument bicolore", category: "contemporain", description: "Création originale et audacieuse associant le granit rouge et noir.", image: imgMonu5 },
  { id: 6, title: "Monument en granit rouge", category: "classique", description: "Sépulture traditionnelle aux finitions soignées en granit rouge.", image: imgMonu6 },
  { id: 7, title: "Monument avec liseré", category: "contemporain", description: "Design moderne et élégant souligné par un fin liseré rouge.", image: imgMonu7 },
];

const categories = [
  { key: "all", label: "Tout le catalogue" },
  { key: "classique", label: "Classique" },
  { key: "contemporain", label: "Contemporain" },
  { key: "personnalise", label: "Personnalisé" },
];
---

<section id="catalogue-gallery" class="relative py-12 sm:py-20 bg-light overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-12 reveal" style="transition-delay: 0.1s">
      {categories.map((cat) => (
        <button
          data-filter-catalogue={cat.key}
          class:list={[
            "gallery-filter-btn-catalogue px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium tracking-wider uppercase transition-all duration-300 border",
            cat.key === "all"
              ? "bg-accent text-white border-accent shadow-lg shadow-accent/20"
              : "bg-light-surface text-dark-text-muted border-border-light hover:border-accent/40 hover:text-accent",
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="catalogue-gallery-grid">
      {galleryItems.map((item, index) => (
        <div
          class="reveal gallery-item-catalogue group cursor-pointer"
          data-category-catalogue={item.category}
          data-index-catalogue={index}
          data-image-src={item.image.src}
          style={`transition-delay: ${(index % 3) * 0.1}s`}
        >
          <div class="relative bg-light-surface border border-border-light rounded-xl overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-accent/10 hover:-translate-y-1">
            <div class="relative w-full aspect-4/3 bg-base-dark overflow-hidden">
              <Image src={item.image} alt={item.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <span class="inline-block px-3 py-1 bg-accent/90 text-white text-[10px] tracking-wider uppercase rounded-full mb-2 font-medium">{item.category.replace("-", " ")}</span>
                  <h3 class="text-white font-heading text-lg font-semibold">{item.title}</h3>
                </div>
              </div>
              <!-- Zoom icon on hover -->
              <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-75 group-hover:scale-100">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </div>
            <!-- Card content -->
            <div class="p-5 flex flex-col justify-between h-[140px] sm:h-[150px]">
              <div>
                <h3 class="font-heading text-lg font-semibold text-dark-text mb-1 group-hover:text-accent transition-colors duration-300">{item.title}</h3>
                <p class="text-dark-text-muted text-sm leading-relaxed line-clamp-2">{item.description}</p>
              </div>
              <div class="mt-4 pt-3 pb-1 border-t border-border-light/50 text-accent text-xs font-semibold uppercase tracking-wider group-hover:underline flex items-center gap-1">
                Détails du modèle
                <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Modal / Lightbox -->
<div id="catalogue-modal" class="fixed inset-0 z-100 hidden items-center justify-center">
  <div id="catalogue-modal-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

  <div id="catalogue-modal-content" class="relative z-10 w-full max-w-4xl mx-4 bg-light-surface rounded-2xl overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
    <button id="catalogue-modal-close" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-base-dark/80 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button id="catalogue-modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="catalogue-modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>

    <div class="grid grid-cols-1 md:grid-cols-2 h-full max-h-[90vh]">
      <!-- Image area -->
      <div class="w-full aspect-4/3 md:aspect-auto md:h-full bg-base-dark relative min-h-[300px]">
        <img id="catalogue-modal-image" src="" alt="Photo en grand" class="absolute inset-0 w-full h-full object-contain" />
      </div>

      <!-- Info area -->
      <div class="p-6 sm:p-8 flex flex-col justify-center bg-light">
        <div class="flex items-center gap-3 mb-4">
          <span id="catalogue-modal-category" class="inline-block px-3 py-1 bg-accent/10 text-accent text-[10px] tracking-wider uppercase rounded-full font-semibold">Catégorie</span>
          <span id="catalogue-modal-counter" class="text-dark-text-muted text-xs">1 / 9</span>
        </div>
        <h3 id="catalogue-modal-title" class="font-heading text-3xl font-semibold text-dark-text mb-4">Titre</h3>
        <p id="catalogue-modal-description" class="text-dark-text-muted leading-relaxed mb-8">Description détaillée du modèle de monument funéraire.</p>
        
        <div class="space-y-4 pt-6 border-t border-border-light">
          <p class="text-sm text-dark-text font-medium">Ce modèle vous intéresse ?</p>
          <a href="/contact" class="inline-flex justify-center items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light w-full">
            Demander un devis pour ce modèle
          </a>
          <a href="https://configurateur.famille.gpggranit.com/famille/CA104234?utm_medium=MARBRERIE%20DU%20HAINAUT&utm_source=c-f" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center gap-2 rounded-sm border border-border-light px-6 py-3 text-sm font-semibold text-dark-text uppercase tracking-wider transition-all duration-300 hover:bg-light-surface-hover w-full">
            Personnaliser dans le configurateur
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Filter logic
  const filterBtns = document.querySelectorAll('.gallery-filter-btn-catalogue');
  const galleryItems = document.querySelectorAll('.gallery-item-catalogue');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter-catalogue');

      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');
        b.classList.add('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      });
      btn.classList.remove('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      btn.classList.add('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');

      galleryItems.forEach((item) => {
        const category = item.getAttribute('data-category-catalogue');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = '';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
            (item as HTMLElement).style.transform = 'translateY(0)';
          }, 50);
        } else {
          (item as HTMLElement).style.opacity = '0';
          (item as HTMLElement).style.transform = 'translateY(20px)';
          setTimeout(() => {
            (item as HTMLElement).style.display = 'none';
          }, 300);
        }
      });
    });
  });

  // Modal logic
  const modal = document.getElementById('catalogue-modal');
  const modalBackdrop = document.getElementById('catalogue-modal-backdrop');
  const modalContent = document.getElementById('catalogue-modal-content');
  const modalClose = document.getElementById('catalogue-modal-close');
  const modalPrev = document.getElementById('catalogue-modal-prev');
  const modalNext = document.getElementById('catalogue-modal-next');
  const modalTitle = document.getElementById('catalogue-modal-title');
  const modalDescription = document.getElementById('catalogue-modal-description');
  const modalCategory = document.getElementById('catalogue-modal-category');
  const modalCounter = document.getElementById('catalogue-modal-counter');
  const modalImage = document.getElementById('catalogue-modal-image');

  const itemsData = Array.from(galleryItems).map(item => ({
    title: item.querySelector('h3')?.textContent || '',
    category: item.getAttribute('data-category-catalogue') || '',
    description: item.querySelector('p')?.textContent || '',
    imageSrc: item.getAttribute('data-image-src') || ''
  }));

  let currentIndex = 0;

  function openModal(index: number) {
    currentIndex = index;
    updateModalContent();
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      modalContent?.classList.remove('scale-95', 'opacity-0');
      modalContent?.classList.add('scale-100', 'opacity-100');
    });
  }

  function closeModal() {
    modalContent?.classList.remove('scale-100', 'opacity-100');
    modalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  }

  function updateModalContent() {
    const item = itemsData[currentIndex];
    if (modalTitle) modalTitle.textContent = item.title;
    if (modalDescription) modalDescription.textContent = item.description;
    if (modalCategory) modalCategory.textContent = item.category.replace("-", " ");
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${itemsData.length}`;
    if (modalImage) (modalImage as HTMLImageElement).src = item.imageSrc;
  }

  function prevItem() {
    currentIndex = currentIndex <= 0 ? itemsData.length - 1 : currentIndex - 1;
    updateModalContent();
  }

  function nextItem() {
    currentIndex = currentIndex >= itemsData.length - 1 ? 0 : currentIndex + 1;
    updateModalContent();
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const index = parseInt(item.getAttribute('data-index-catalogue') || '0');
      openModal(index);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalPrev?.addEventListener('click', (e) => { e.stopPropagation(); prevItem(); });
  modalNext?.addEventListener('click', (e) => { e.stopPropagation(); nextItem(); });

  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') prevItem();
    if (e.key === 'ArrowRight') nextItem();
  });
</script>
