---
const galleryItems = [
  {
    id: 1,
    title: "Monument classique granit",
    category: "classique",
    description: "Monument funéraire en granit gris classique avec stèle doucine et semelle.",
  },
  {
    id: 2,
    title: "Monument moderne",
    category: "moderne",
    description: "Conception épurée en granit noir fin absolu avec incrustations.",
  },
  {
    id: 3,
    title: "Caveau familial",
    category: "caveau",
    description: "Grand caveau familial avec habillage complet en granit massif.",
  },
  {
    id: 4,
    title: "Monument personnalisé",
    category: "personnalise",
    description: "Réalisation sur mesure avec stèle sculptée selon les souhaits de la famille.",
  },
  {
    id: 5,
    title: "Monument double",
    category: "classique",
    description: "Monument double pour concession large, finition polie brillante.",
  },
  {
    id: 6,
    title: "Création originale",
    category: "moderne",
    description: "Association de deux granits différents pour un rendu contemporain et unique.",
  },
];

const categories = [
  { key: "all", label: "Tout voir" },
  { key: "classique", label: "Classique" },
  { key: "moderne", label: "Moderne" },
  { key: "caveau", label: "Caveau" },
  { key: "personnalise", label: "Personnalisé" },
];
---

<section id="caveau-gallery" class="relative py-24 sm:py-32 bg-light overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-12 reveal">
      <span class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block">Nos réalisations</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text mb-4">
        Exemples de <span class="text-accent">Monuments</span>
      </h2>
      <p class="text-dark-text-muted max-w-2xl mx-auto leading-relaxed">
        Découvrez quelques unes de nos créations. Chaque monument est conçu sur mesure pour honorer la mémoire de vos proches de manière unique.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-12 reveal" style="transition-delay: 0.1s">
      {categories.map((cat) => (
        <button
          data-filter-caveau={cat.key}
          class:list={[
            "gallery-filter-btn-caveau px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium tracking-wider uppercase transition-all duration-300 border",
            cat.key === "all"
              ? "bg-accent text-white border-accent shadow-lg shadow-accent/20"
              : "bg-light-surface text-dark-text-muted border-border-light hover:border-accent/40 hover:text-accent",
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="caveau-gallery-grid">
      {galleryItems.map((item, index) => (
        <div
          class="reveal gallery-item-caveau group cursor-pointer"
          data-category-caveau={item.category}
          data-index-caveau={index}
          style={`transition-delay: ${index * 0.1}s`}
        >
          <div class="relative bg-light-surface border border-border-light rounded-xl overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-accent/10 hover:-translate-y-1">
            <!-- Image placeholder -->
            <div class="relative w-full aspect-4/3 bg-linear-to-br from-base-darker via-surface to-base-dark overflow-hidden">
              <svg class="absolute inset-0 w-full h-full opacity-[0.06]" viewBox="0 0 400 300" preserveAspectRatio="none">
                <path d="M0,150 Q100,130 200,160 T400,140" stroke="white" stroke-width="1.5" fill="none" />
                <path d="M0,80 Q150,60 300,100 T400,70" stroke="white" stroke-width="1" fill="none" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center text-text-muted/50">
                <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                </svg>
                <span class="text-xs tracking-wider uppercase">Photo — {item.title}</span>
              </div>
              <!-- Hover overlay -->
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <span class="inline-block px-3 py-1 bg-accent/90 text-white text-[10px] tracking-wider uppercase rounded-full mb-2 font-medium">{item.category}</span>
                  <h3 class="text-white font-heading text-lg font-semibold">{item.title}</h3>
                </div>
              </div>
              <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-75 group-hover:scale-100">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </div>
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-dark-text mb-1 group-hover:text-accent transition-colors duration-300">{item.title}</h3>
              <p class="text-dark-text-muted text-sm leading-relaxed line-clamp-2">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Modal -->
<div id="caveau-modal" class="fixed inset-0 z-100 hidden items-center justify-center">
  <div id="caveau-modal-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div id="caveau-modal-content" class="relative z-10 w-full max-w-4xl mx-4 bg-light-surface rounded-2xl overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
    <button id="caveau-modal-close" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-base-dark/80 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="caveau-modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="caveau-modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
    <div class="w-full aspect-16/10 bg-linear-to-br from-base-darker via-surface to-base-dark relative">
      <div class="absolute inset-0 flex flex-col items-center justify-center text-text-muted/50">
        <svg class="w-16 h-16 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
        </svg>
        <span id="caveau-modal-placeholder-text" class="text-sm tracking-wider uppercase">Photo placeholder</span>
      </div>
    </div>
    <div class="p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-3">
        <span id="caveau-modal-category" class="inline-block px-3 py-1 bg-accent/10 text-accent text-[10px] tracking-wider uppercase rounded-full font-semibold">Catégorie</span>
        <span id="caveau-modal-counter" class="text-dark-text-muted text-xs">1 / 6</span>
      </div>
      <h3 id="caveau-modal-title" class="font-heading text-2xl font-semibold text-dark-text mb-2">Titre</h3>
      <p id="caveau-modal-description" class="text-dark-text-muted leading-relaxed">Description</p>
    </div>
  </div>
</div>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn-caveau');
  const galleryItems = document.querySelectorAll('.gallery-item-caveau');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter-caveau');
      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');
        b.classList.add('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      });
      btn.classList.remove('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      btn.classList.add('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');

      galleryItems.forEach((item) => {
        const category = item.getAttribute('data-category-caveau');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = '';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
            (item as HTMLElement).style.transform = 'translateY(0)';
          }, 50);
        } else {
          (item as HTMLElement).style.opacity = '0';
          (item as HTMLElement).style.transform = 'translateY(20px)';
          setTimeout(() => {
            (item as HTMLElement).style.display = 'none';
          }, 300);
        }
      });
    });
  });

  const modal = document.getElementById('caveau-modal');
  const modalBackdrop = document.getElementById('caveau-modal-backdrop');
  const modalContent = document.getElementById('caveau-modal-content');
  const modalClose = document.getElementById('caveau-modal-close');
  const modalPrev = document.getElementById('caveau-modal-prev');
  const modalNext = document.getElementById('caveau-modal-next');
  const modalTitle = document.getElementById('caveau-modal-title');
  const modalDescription = document.getElementById('caveau-modal-description');
  const modalCategory = document.getElementById('caveau-modal-category');
  const modalCounter = document.getElementById('caveau-modal-counter');
  const modalPlaceholder = document.getElementById('caveau-modal-placeholder-text');

  const itemsData = [
    { title: "Monument classique granit", category: "classique", description: "Monument funéraire en granit gris classique avec stèle doucine et semelle." },
    { title: "Monument moderne", category: "moderne", description: "Conception épurée en granit noir fin absolu avec incrustations." },
    { title: "Caveau familial", category: "caveau", description: "Grand caveau familial avec habillage complet en granit massif." },
    { title: "Monument personnalisé", category: "personnalise", description: "Réalisation sur mesure avec stèle sculptée selon les souhaits de la famille." },
    { title: "Monument double", category: "classique", description: "Monument double pour concession large, finition polie brillante." },
    { title: "Création originale", category: "moderne", description: "Association de deux granits différents pour un rendu contemporain et unique." },
  ];

  let currentIndex = 0;

  function openModal(index: number) {
    currentIndex = index;
    updateModalContent();
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      modalContent?.classList.remove('scale-95', 'opacity-0');
      modalContent?.classList.add('scale-100', 'opacity-100');
    });
  }

  function closeModal() {
    modalContent?.classList.remove('scale-100', 'opacity-100');
    modalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  }

  function updateModalContent() {
    const item = itemsData[currentIndex];
    if (modalTitle) modalTitle.textContent = item.title;
    if (modalDescription) modalDescription.textContent = item.description;
    if (modalCategory) modalCategory.textContent = item.category;
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${itemsData.length}`;
    if (modalPlaceholder) modalPlaceholder.textContent = `Photo — ${item.title}`;
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const index = parseInt(item.getAttribute('data-index-caveau') || '0');
      openModal(index);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalPrev?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = currentIndex <= 0 ? itemsData.length - 1 : currentIndex - 1; updateModalContent(); });
  modalNext?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = currentIndex >= itemsData.length - 1 ? 0 : currentIndex + 1; updateModalContent(); });

  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') { currentIndex = currentIndex <= 0 ? itemsData.length - 1 : currentIndex - 1; updateModalContent(); }
    if (e.key === 'ArrowRight') { currentIndex = currentIndex >= itemsData.length - 1 ? 0 : currentIndex + 1; updateModalContent(); }
  });
</script>
