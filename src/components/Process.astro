---
const steps = [
  {
    number: "01",
    title: "Concevez votre monument en 3D",
    description: "Grâce à notre outil de configuration en ligne, visualisez et personnalisez votre monument funéraire selon vos goûts. Un large choix de formes et de granits vous y attend.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" /></svg>`
  },
  {
    number: "02",
    title: "Demandez un devis gratuit",
    description: "Une fois votre configuration terminée sur notre plateforme, transmettez-nous votre projet en un clic. Nous établirons un devis précis et personnalisé, sans aucun engagement.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>`
  },
  {
    number: "03",
    title: "Validez votre choix",
    description: "Votre choix est fait ? Confirmez et validez votre commande. Notre équipe se charge de tout, de la conception à la pose.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  }
];
---

<section id="process" class="relative py-24 sm:py-32 bg-light overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block">Comment ça marche</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text">
        Un processus <span class="text-accent">simple et transparent</span>
      </h2>
    </div>

    <!-- Steps grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 relative">
      <!-- Connection line (desktop) -->
      <div class="hidden md:block absolute top-16 left-[20%] right-[20%] h-px bg-linear-to-r from-accent/20 via-accent/40 to-accent/20"></div>

      {steps.map((step, index) => (
        <div class="reveal relative group h-full" style={`transition-delay: ${index * 0.15}s`}>
          <div class="relative bg-light-surface border border-border-light rounded-xl p-8 text-center transition-all duration-500 hover:shadow-xl hover:shadow-accent/5 hover:-translate-y-1 h-full flex flex-col">
            <!-- Step number -->
            <div class="relative mx-auto mb-6 w-14 h-14 rounded-full bg-accent/10 border-2 border-accent/30 flex items-center justify-center text-accent font-heading text-lg font-bold transition-colors duration-300 group-hover:bg-accent group-hover:text-white group-hover:border-accent z-10">
              {step.number}
            </div>

            <!-- Icon -->
            <div class="text-accent-dark mb-4 flex justify-center" set:html={step.icon} />

            <!-- Content -->
            <h3 class="font-heading text-xl font-semibold text-dark-text mb-3">{step.title}</h3>
            <p class="text-dark-text-muted text-sm leading-relaxed mb-6 grow">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Centered CTA below the grid -->
    <div class="mt-16 text-center reveal">
      <a 
        href="https://configurateur.famille.gpggranit.com/famille/CA104234?utm_medium=MARBRERIE%20DU%20HAINAUT&utm_source=c-f" target="_blank" rel="noopener noreferrer" 
        id="link-configurateur-3d-process"
        class="inline-flex items-center gap-2 rounded-sm bg-accent px-8 py-3.5 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light hover:shadow-xl hover:shadow-accent/25 hover:-translate-y-0.5"
      >
        Ouvrir le configurateur 3D
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </div>
</section>
