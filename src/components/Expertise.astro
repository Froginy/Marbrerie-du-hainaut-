---
import { Image } from "astro:assets";
import artisanImg from "../assets/artisan_upscaled.png";
---

<section
  id="expertise"
  class="relative py-24 sm:py-32 bg-light-alt overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Image placeholder -->
      <div class="reveal">
        <div
          class="relative rounded-xl overflow-hidden shadow-2xl shadow-accent/10"
        >
          <!-- Image -->
          <div class="relative w-full h-[400px] sm:h-[480px] bg-base-dark overflow-hidden group">
            <Image
              src={artisanImg}
              alt="Artisan marbrier au travail sur un chantier"
              class="absolute inset-0 w-full h-full object-cover object-[center_65%] transition-transform duration-700 group-hover:scale-105"
            />
            <!-- Subtle gradient to blend with the website design -->
            <div class="absolute inset-0 bg-linear-to-t from-base-darker/40 via-transparent to-transparent mix-blend-multiply"></div>
          </div>
          <!-- Accent corner decorations -->
          <div
            class="absolute -bottom-3 -right-3 w-28 h-28 border-b-2 border-r-2 border-gold/30 rounded-br-xl"
          >
          </div>
          <div
            class="absolute -top-3 -left-3 w-28 h-28 border-t-2 border-l-2 border-accent/30 rounded-tl-xl"
          >
          </div>
        </div>
      </div>

      <!-- Text content -->
      <div class="reveal" style="transition-delay: 0.2s">
        <span
          class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block"
          >Notre expertise</span
        >
        <h2
          class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text mb-6 leading-tight"
        >
          Nous sommes des <span class="text-accent">artisans experts</span>
        </h2>

        <div class="space-y-4 mb-8">
          <p class="text-dark-text-muted leading-relaxed">
            Au cours de toutes ces années, nous avons acquis un savoir-faire
            qu'aujourd'hui, nous pouvons allier fièrement à la technologie. De
            par cette expérience, nous avons l'inspiration et la technique qu'il
            faut en tant qu'artisan marbrier.
          </p>
          <p class="text-dark-text-muted leading-relaxed">
            Vous pourrez choisir, avec nos conseils avisés, le modèle, la taille
            et la décoration de votre monument funéraire. Notre mission est de
            vous proposer des <span class="text-dark-text font-semibold"
              >monuments uniques et personnalisés</span
            >.
          </p>
        </div>

        <!-- Stats row -->
        <div
          class="grid grid-cols-2 sm:grid-cols-3 gap-6 mb-8 py-6 border-t border-b border-border-light text-center sm:text-left"
        >
          <div class="col-span-1">
            <span
              class="font-heading text-2xl sm:text-3xl font-bold text-accent"
              >15+</span
            >
            <p
              class="text-dark-text-muted text-[10px] sm:text-xs tracking-wider uppercase mt-1"
            >
              Années d'expérience
            </p>
          </div>
          <div class="col-span-1">
            <span
              class="font-heading text-2xl sm:text-3xl font-bold text-accent"
              >500+</span
            >
            <p
              class="text-dark-text-muted text-[10px] sm:text-xs tracking-wider uppercase mt-1"
            >
              Réalisations
            </p>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <span
              class="font-heading text-2xl sm:text-3xl font-bold text-accent"
              >100%</span
            >
            <p
              class="text-dark-text-muted text-[10px] sm:text-xs tracking-wider uppercase mt-1"
            >
              Sur mesure
            </p>
          </div>
        </div>

        <a
          href="/catalogue"
          id="expertise-cta"
          class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 group"
        >
          Découvrir notre catalogue
          <svg
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
