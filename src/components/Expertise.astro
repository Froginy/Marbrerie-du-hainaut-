---
---

<section id="expertise" class="relative py-24 sm:py-32 bg-light-alt overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Image placeholder -->
      <div class="reveal">
        <div class="relative rounded-xl overflow-hidden shadow-2xl shadow-accent/10">
          <!-- Placeholder image -->
          <div class="w-full h-[400px] sm:h-[480px] bg-gradient-to-br from-base-darker via-surface to-base-dark relative">
            <!-- Marble vein decoration -->
            <svg class="absolute inset-0 w-full h-full opacity-[0.06]" viewBox="0 0 560 480" preserveAspectRatio="none">
              <path d="M0,200 Q140,180 280,220 T560,200" stroke="white" stroke-width="1.5" fill="none" />
              <path d="M0,350 Q200,330 400,370 T560,340" stroke="white" stroke-width="1" fill="none" />
              <path d="M150,0 Q160,200 140,400 T160,480" stroke="white" stroke-width="0.8" fill="none" />
            </svg>
            <!-- Placeholder content -->
            <div class="absolute inset-0 flex flex-col items-center justify-center text-text-muted/50">
              <svg class="w-16 h-16 mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
              </svg>
              <span class="text-sm tracking-wider uppercase">Photo atelier</span>
              <span class="text-xs mt-1">560 × 480</span>
            </div>
          </div>
          <!-- Accent corner decorations -->
          <div class="absolute -bottom-3 -right-3 w-28 h-28 border-b-2 border-r-2 border-gold/30 rounded-br-xl"></div>
          <div class="absolute -top-3 -left-3 w-28 h-28 border-t-2 border-l-2 border-accent/30 rounded-tl-xl"></div>
        </div>
      </div>

      <!-- Text content -->
      <div class="reveal" style="transition-delay: 0.2s">
        <span class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block">Notre expertise</span>
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text mb-6 leading-tight">
          Nous sommes des <span class="text-accent">artisans experts</span>
        </h2>

        <div class="space-y-4 mb-8">
          <p class="text-dark-text-muted leading-relaxed">
            Au cours de toutes ces années, nous avons acquis un savoir-faire qu'aujourd'hui, nous pouvons allier fièrement à la technologie. De par cette expérience, nous avons l'inspiration et la technique qu'il faut en tant qu'artisan marbrier.
          </p>
          <p class="text-dark-text-muted leading-relaxed">
            Vous pourrez choisir, avec nos conseils avisés, le modèle, la taille et la décoration de votre monument funéraire. Notre mission est de vous proposer des <span class="text-dark-text font-semibold">monuments uniques et personnalisés</span>.
          </p>
        </div>

        <!-- Stats row -->
        <div class="grid grid-cols-3 gap-6 mb-8 py-6 border-t border-b border-border-light">
          <div>
            <span class="font-heading text-2xl sm:text-3xl font-bold text-accent">15+</span>
            <p class="text-dark-text-muted text-xs tracking-wider uppercase mt-1">Années d'expérience</p>
          </div>
          <div>
            <span class="font-heading text-2xl sm:text-3xl font-bold text-accent">500+</span>
            <p class="text-dark-text-muted text-xs tracking-wider uppercase mt-1">Réalisations</p>
          </div>
          <div>
            <span class="font-heading text-2xl sm:text-3xl font-bold text-accent">100%</span>
            <p class="text-dark-text-muted text-xs tracking-wider uppercase mt-1">Sur mesure</p>
          </div>
        </div>

        <a
          href="/nos-realisations"
          id="expertise-cta"
          class="inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light hover:shadow-lg hover:shadow-accent/20 hover:-translate-y-0.5 group"
        >
          Découvrir nos réalisations
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
