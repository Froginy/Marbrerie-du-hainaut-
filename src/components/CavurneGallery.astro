---
import { Image } from "astro:assets";
import imgCavurne1 from "../assets/cavurnes/ensemble-cavurnes-tiroirs.jpg";
import imgCavurne2 from "../assets/cavurnes/cavurne-gris-rose.jpg";
import imgCavurne3 from "../assets/cavurnes/cavurne-noir-moto.jpg";
import imgCavurne4 from "../assets/cavurnes/cavurne-noir-mat.jpg";
import imgCavurne5 from "../assets/cavurnes/cavurne-noir-paysage.jpg";
import imgCavurne6 from "../assets/cavurnes/cavurne-rouge-1.jpg";
import imgCavurne7 from "../assets/cavurnes/cavurne-rouge-2.jpg";
import imgCavurne8 from "../assets/cavurnes/cavurne-rouge-3.jpg";
import imgCavurne9 from "../assets/cavurnes/cavurne-rouge-4.jpg";

const galleryItems = [
  { id: 1, title: "Ensemble de cavurnes", category: "classique", description: "Aménagement complet avec tiroirs cinéraires.", image: imgCavurne1 },
  { id: 2, title: "Cavurne en granit gris", category: "personnalise", description: "Monument cinéraire avec gravure florale d'une rose.", image: imgCavurne2 },
  { id: 3, title: "Cavurne personnalisée", category: "personnalise", description: "Stèle noire avec gravure sur mesure (moto).", image: imgCavurne3 },
  { id: 4, title: "Cavurne noir mat", category: "moderne", description: "Design sobre et élégant en finition noire mate.", image: imgCavurne4 },
  { id: 5, title: "Cavurne avec paysage", category: "personnalise", description: "Monument noir orné d'une belle gravure de coucher de soleil.", image: imgCavurne5 },
  { id: 6, title: "Cavurne en granit rouge", category: "classique", description: "Monument cinéraire classique et robuste en granit rouge.", image: imgCavurne6 },
  { id: 7, title: "Cavurne rouge épurée", category: "classique", description: "Design simple et intemporel en granit rouge.", image: imgCavurne7 },
  { id: 8, title: "Cavurne avec jardinière", category: "classique", description: "Monument rouge intégrant un espace de recueillement et des vases.", image: imgCavurne8 },
  { id: 9, title: "Cavurne rouge sculptée", category: "classique", description: "Stèle rouge avec une forme travaillée et harmonieuse.", image: imgCavurne9 },
];

const categories = [
  { key: "all", label: "Tout voir" },
  { key: "classique", label: "Classique" },
  { key: "moderne", label: "Moderne" },
  { key: "personnalise", label: "Personnalisé" },
];
---

<section id="cavurne-gallery" class="relative py-24 sm:py-32 bg-light overflow-hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 reveal">
      <span class="text-accent text-xs font-semibold tracking-[0.3em] uppercase mb-4 block">Nos réalisations</span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-semibold text-dark-text mb-4">
        Exemples de <span class="text-accent">Cavurnes</span>
      </h2>
      <p class="text-dark-text-muted max-w-2xl mx-auto leading-relaxed">
        Découvrez notre sélection de monuments cinéraires. Chaque cavurne est pensée pour offrir un lieu de recueillement intime et durable.
      </p>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap justify-center gap-2 sm:gap-3 mb-12 reveal" style="transition-delay: 0.1s">
      {categories.map((cat) => (
        <button
          data-filter-cavurne={cat.key}
          class:list={[
            "gallery-filter-btn-cavurne px-5 py-2.5 rounded-full text-xs sm:text-sm font-medium tracking-wider uppercase transition-all duration-300 border",
            cat.key === "all"
              ? "bg-accent text-white border-accent shadow-lg shadow-accent/20"
              : "bg-light-surface text-dark-text-muted border-border-light hover:border-accent/40 hover:text-accent",
          ]}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Gallery grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="cavurne-gallery-grid">
      {galleryItems.map((item, index) => (
        <div
          class="reveal gallery-item-cavurne group cursor-pointer"
          data-category-cavurne={item.category}
          data-index-cavurne={index}
          data-image-src={item.image.src}
          style={`transition-delay: ${index * 0.1}s`}
        >
          <div class="relative bg-light-surface border border-border-light rounded-xl overflow-hidden transition-all duration-500 hover:shadow-2xl hover:shadow-accent/10 hover:-translate-y-1">
            <div class="relative w-full aspect-4/3 bg-base-dark overflow-hidden">
              <Image src={item.image} alt={item.title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-5">
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <span class="inline-block px-3 py-1 bg-accent/90 text-white text-[10px] tracking-wider uppercase rounded-full mb-2 font-medium">{item.category}</span>
                  <h3 class="text-white font-heading text-lg font-semibold">{item.title}</h3>
                </div>
              </div>
              <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-75 group-hover:scale-100">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </div>
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-dark-text mb-1 group-hover:text-accent transition-colors duration-300">{item.title}</h3>
              <p class="text-dark-text-muted text-sm leading-relaxed line-clamp-2">{item.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Modal -->
<div id="cavurne-modal" class="fixed inset-0 z-100 hidden items-center justify-center">
  <div id="cavurne-modal-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>
  <div id="cavurne-modal-content" class="relative z-10 w-full max-w-4xl mx-4 bg-light-surface rounded-2xl overflow-hidden shadow-2xl transform scale-95 opacity-0 transition-all duration-300">
    <button id="cavurne-modal-close" class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-base-dark/80 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button id="cavurne-modal-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </button>
    <button id="cavurne-modal-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-base-dark/60 backdrop-blur-sm flex items-center justify-center text-white/80 hover:text-white hover:bg-accent transition-all duration-300">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </button>
    <div class="w-full aspect-16/10 bg-base-dark relative">
      <img id="cavurne-modal-image" src="" alt="Photo en grand" class="absolute inset-0 w-full h-full object-contain" />
    </div>
    <div class="p-6 sm:p-8">
      <div class="flex items-center gap-3 mb-3">
        <span id="cavurne-modal-category" class="inline-block px-3 py-1 bg-accent/10 text-accent text-[10px] tracking-wider uppercase rounded-full font-semibold">Catégorie</span>
        <span id="cavurne-modal-counter" class="text-dark-text-muted text-xs">1 / 6</span>
      </div>
      <h3 id="cavurne-modal-title" class="font-heading text-2xl font-semibold text-dark-text mb-2">Titre</h3>
      <p id="cavurne-modal-description" class="text-dark-text-muted leading-relaxed">Description</p>
    </div>
  </div>
</div>

<script>
  const filterBtns = document.querySelectorAll('.gallery-filter-btn-cavurne');
  const galleryItems = document.querySelectorAll('.gallery-item-cavurne');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter-cavurne');
      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');
        b.classList.add('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      });
      btn.classList.remove('bg-light-surface', 'text-dark-text-muted', 'border-border-light');
      btn.classList.add('bg-accent', 'text-white', 'border-accent', 'shadow-lg', 'shadow-accent/20');

      galleryItems.forEach((item) => {
        const category = item.getAttribute('data-category-cavurne');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = '';
          setTimeout(() => {
            (item as HTMLElement).style.opacity = '1';
            (item as HTMLElement).style.transform = 'translateY(0)';
          }, 50);
        } else {
          (item as HTMLElement).style.opacity = '0';
          (item as HTMLElement).style.transform = 'translateY(20px)';
          setTimeout(() => {
            (item as HTMLElement).style.display = 'none';
          }, 300);
        }
      });
    });
  });

  const modal = document.getElementById('cavurne-modal');
  const modalBackdrop = document.getElementById('cavurne-modal-backdrop');
  const modalContent = document.getElementById('cavurne-modal-content');
  const modalClose = document.getElementById('cavurne-modal-close');
  const modalPrev = document.getElementById('cavurne-modal-prev');
  const modalNext = document.getElementById('cavurne-modal-next');
  const modalTitle = document.getElementById('cavurne-modal-title');
  const modalDescription = document.getElementById('cavurne-modal-description');
  const modalCategory = document.getElementById('cavurne-modal-category');
  const modalCounter = document.getElementById('cavurne-modal-counter');
  const modalImage = document.getElementById('cavurne-modal-image');

  const itemsData = Array.from(galleryItems).map(item => ({
    title: item.querySelector('h3')?.textContent || '',
    category: item.getAttribute('data-category-cavurne') || '',
    description: item.querySelector('p')?.textContent || '',
    imageSrc: item.getAttribute('data-image-src') || ''
  }));

  let currentIndex = 0;

  function openModal(index: number) {
    currentIndex = index;
    updateModalContent();
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => {
      modalContent?.classList.remove('scale-95', 'opacity-0');
      modalContent?.classList.add('scale-100', 'opacity-100');
    });
  }

  function closeModal() {
    modalContent?.classList.remove('scale-100', 'opacity-100');
    modalContent?.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      document.body.style.overflow = '';
    }, 300);
  }

  function updateModalContent() {
    const item = itemsData[currentIndex];
    if (modalTitle) modalTitle.textContent = item.title;
    if (modalDescription) modalDescription.textContent = item.description;
    if (modalCategory) modalCategory.textContent = item.category;
    if (modalCounter) modalCounter.textContent = `${currentIndex + 1} / ${itemsData.length}`;
    if (modalImage) (modalImage as HTMLImageElement).src = item.imageSrc;
  }

  galleryItems.forEach((item) => {
    item.addEventListener('click', () => {
      const index = parseInt(item.getAttribute('data-index-cavurne') || '0');
      openModal(index);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);
  modalPrev?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = currentIndex <= 0 ? itemsData.length - 1 : currentIndex - 1; updateModalContent(); });
  modalNext?.addEventListener('click', (e) => { e.stopPropagation(); currentIndex = currentIndex >= itemsData.length - 1 ? 0 : currentIndex + 1; updateModalContent(); });

  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') { currentIndex = currentIndex <= 0 ? itemsData.length - 1 : currentIndex - 1; updateModalContent(); }
    if (e.key === 'ArrowRight') { currentIndex = currentIndex >= itemsData.length - 1 ? 0 : currentIndex + 1; updateModalContent(); }
  });
</script>
