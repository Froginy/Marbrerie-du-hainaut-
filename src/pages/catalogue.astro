---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CatalogueGallery from "../components/CatalogueGallery.astro";
---

<Layout
  title="Catalogue de Monuments Funéraires | Marbrerie du Hainaut"
  description="Parcourez notre catalogue de monuments funéraires, cavurnes et habillages de pleine terre. Modèles classiques ou contemporains sur mesure."
>
  <Navbar />

  <main class="pt-20">
    <!-- Compact Hero Section -->
    <section class="relative bg-base-darker pt-24 pb-16 overflow-hidden shadow-inner">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-base-darker via-surface to-base-dark"></div>
        <svg class="absolute inset-0 w-full h-full opacity-[0.06]" viewBox="0 0 1200 400" preserveAspectRatio="none">
          <path d="M0,200 Q300,150 600,220 T1200,180" stroke="white" stroke-width="2" fill="none" />
          <path d="M0,100 Q400,80 700,150 T1200,100" stroke="white" stroke-width="1.2" fill="none" />
        </svg>
        <div class="absolute inset-0 bg-gradient-to-b from-base-darker/60 via-transparent to-base-darker/80"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center reveal">
        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-semibold text-text drop-shadow-md">
          Notre <span class="text-accent-light">Catalogue</span>
        </h1>
        <p class="mt-4 text-text-muted max-w-2xl mx-auto text-base sm:text-lg leading-relaxed">
          Explorez nos modèles pour trouver l'inspiration. Tous nos monuments peuvent être personnalisés ou modifiés selon vos souhaits.
        </p>
      </div>
    </section>

    <!-- Catalogue Gallery Section -->
    <CatalogueGallery />

    <!-- Compact CTA Section -->
    <section class="relative py-16 bg-base-darker overflow-hidden border-t border-border">
      <div class="absolute inset-0">
        <svg class="absolute inset-0 w-full h-full opacity-[0.03]" viewBox="0 0 1200 200" preserveAspectRatio="none">
          <path d="M0,100 Q300,50 600,120 T1200,80" stroke="white" stroke-width="2" fill="none" />
        </svg>
      </div>
      <div class="relative z-10 mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 text-center reveal">
        <h2 class="font-heading text-2xl sm:text-3xl font-semibold text-text mb-6">
          Un modèle a retenu votre attention ?
        </h2>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 w-full max-w-md mx-auto sm:max-w-none">
          <a
            href="/contact"
            class="inline-flex justify-center items-center gap-2 rounded-sm bg-accent px-8 py-3.5 text-sm font-semibold text-white uppercase tracking-wider transition-all duration-300 hover:bg-accent-light hover:shadow-xl hover:shadow-accent/25 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Obtenir un devis
          </a>
          <a
            href="/conception-3d"
            class="inline-flex justify-center items-center gap-2 rounded-sm border border-text/30 px-8 py-3.5 text-sm font-semibold text-text uppercase tracking-wider transition-all duration-300 hover:bg-text/10 hover:border-text/60 hover:-translate-y-0.5 w-full sm:w-auto"
          >
            Configurateur 3D
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
